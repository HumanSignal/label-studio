
# Turnstile configuration
export TURNSTILE_SITE_KEY=
export TURNSTILE_SECRET_KEY=

# Cloudflare tunnel token
export CLOUDFLARE_TUNNEL_TOKEN=

# Label Studio configuration
export LABEL_STUDIO_HOST=
export CSRF_TRUSTED_ORIGINS=


# Stripe Configuration
# Copy this file to .env and fill in your actual Stripe credentials
# The .env file is automatically loaded by docker-compose.yml

# Stripe Mode
# Set to 'true' to use live mode, 'false' for test mode
STRIPE_LIVE_MODE=false

# Stripe Live Mode Credentials (only needed when STRIPE_LIVE_MODE=true)
# Get these from: https://dashboard.stripe.com/apikeys (Live mode)
STRIPE_LIVE_SECRET_KEY=sk_live_...
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_...

# Stripe Test Mode Credentials (used when STRIPE_LIVE_MODE=false)
# Get these from: https://dashboard.stripe.com/apikeys (Test mode)
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...

# Stripe Pricing Table ID
# The ID of your Stripe Pricing Table (found in Stripe Dashboard > Products > Pricing Tables)
STRIPE_PRICING_TABLE_ID=prctbl_...

# Stripe Webhook Secret
# The webhook signing secret from Stripe Dashboard > Developers > Webhooks
# For local development with Stripe CLI, use: whsec_...
DJSTRIPE_WEBHOOK_SECRET=whsec_...
