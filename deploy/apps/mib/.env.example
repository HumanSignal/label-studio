# Public application URL
LABEL_STUDIO_HOST=https://mib.biowork.app
HOST=https://mib.biowork.app
CSRF_TRUSTED_ORIGINS=https://mib.biowork.app

# Runtime behavior
LOG_LEVEL=ERROR
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
TURNSTILE_ENABLED=true

# Database
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRE_NAME=postgres
POSTGRE_USER=postgres
POSTGRE_PASSWORD=change-me

# Optional compose overrides. These are read when passed with:
# docker compose --env-file deploy/apps/mib/.env -f docker-compose.mib.yml up -d
IMAGE_TAG=latest
MIB_HTTP_BIND=127.0.0.1
MIB_HTTP_PORT=8080
MIB_HTTPS_BIND=127.0.0.1
MIB_HTTPS_PORT=8081
MIB_POSTGRES_DATA_DIR=./postgres-data

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe
STRIPE_LIVE_MODE=false
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_PRICING_TABLE_ID=
DJSTRIPE_WEBHOOK_SECRET=
