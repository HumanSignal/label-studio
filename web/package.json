{
  "name": "@humansignal/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "ui:serve": "bun --bun run storybook dev -c libs/storybook/.storybook --port 4400",
    "ui:test:component": "TZ=UTC bun run jest --config libs/ui/jest.config.ts",
    "biome": "biome",
    "lint": "bun --bun run biome check --write .",
    "lint-css": "bun --bun run biome check --write '**/*.css'",
    "dev": "NODE_ENV=development BUILD_NO_SERVER=true bun --bun run vite",
    "build:dev": "BUILD_NO_SERVER=true bun --bun run vite build --mode development",
    "build:app": "bun --bun run vite build && bun ./tools/build-service-worker.mjs",
    "build": "bun run build:app",
    "watch": "BUILD_NO_SERVER=true bun --bun run vite build --mode development --watch",
    "ls:e2e": "bun --bun run cypress run --project apps/labelstudio-e2e",
    "lsf:build": "NODE_ENV=production MODE=standalone bun --bun run vite build --config vite.config.editor.ts",
    "lsf:build:coverage": "NODE_ENV=production BABEL_ENV=test MODE=standalone bun --bun run vite build --config vite.config.editor.ts",
    "lsf:watch": "NODE_ENV=development MODE=standalone bun --bun run vite build --config vite.config.editor.ts --mode development --watch",
    "lsf:serve": "NODE_ENV=development MODE=standalone bun --bun run vite preview --config vite.config.editor.ts --port 3000 --host",
    "lsf:serve-build": "bun libs/editor/server.mjs",
    "lsf:integration": "NODE_ENV=production MODE=standalone bun --bun run cypress run --config-file libs/editor/cypress.config.ts",
    "lsf:integration:slow": "DEFAULT_CPU_THROTTLING=4 DEFAULT_NETWORK_THROTTLING=4g bun --bun run cypress run --config-file libs/editor/cypress.config.ts",
    "lsf:integration:watch": "NODE_ENV=production MODE=standalone bun --bun run cypress open --config-file libs/editor/cypress.config.ts",
    "lsf:integration:watch:slow": "DEFAULT_CPU_THROTTLING=10 DEFAULT_NETWORK_THROTTLING=4g bun --bun run cypress open --config-file libs/editor/cypress.config.ts",
    "dm:watch": "bun run watch",
    "version:libs": "(cd apps/labelstudio && bun ../../tools/version/version.mjs) && (cd libs/editor && bun ../../tools/version/version.mjs) && (cd libs/datamanager && bun ../../tools/version/version.mjs)",
    "docs": "sh -c 'export SCHEMA_JSON_PATH=\"$PWD/libs/core/src/lib/utils/schema/tags.json\" && cd libs/editor && bun ../../tools/create-docs/create-docs.mjs ../../../docs/source/includes/tags' && bun --bun run biome check --write libs/core/src/lib/utils/schema/tags.json",
    "test:e2e": "NODE_ENV=production MODE=standalone bun run ls:e2e && NODE_ENV=production MODE=standalone bun run lsf:integration",
    "test:integration": "bun run lsf:integration",
    "ls:unit": "bun test --dom apps/labelstudio/src",
    "lsf:unit": "bun test --dom libs/editor/src",
    "dm:unit": "bun test --dom libs/datamanager/src",
    "test:unit": "bun test --dom",
    "test:unit:coverage": "yarn run test:unit --coverage",
    "test:unit:editor": "bun test --dom libs/editor/src",
    "test:unit:core": "bun test --dom libs/core/src",
    "test:unit:datamanager": "bun test --dom libs/datamanager/src",
    "test:unit:ui": "bun test --dom libs/ui/src",
    "test:unit:app-common": "bun test --dom libs/app-common/src",
    "test:unit:storybook": "bun test --dom libs/storybook/src",
    "test:unit:labelstudio": "bun test --dom apps/labelstudio/src",
    "test:unit:playground": "bun test --dom apps/playground/src",
    "design-tokens": "bun tools/design-tokens-converter/design-tokens-converter.mjs",
    "extract-antd-no-reset": "cd libs/editor && bun ../../tools/extract-antd-no-reset/extract-antd-no-reset.mjs",
    "storybook:serve": "bun run storybook dev -c libs/storybook/.storybook --port 4400",
    "storybook:build": "bun run storybook build -c libs/storybook/.storybook -o dist/libs/storybook/storybook",
    "playground:serve": "FRONTEND_HOSTNAME=http://localhost:4200 bun --bun run vite --config vite.config.playground.ts",
    "playground:build": "NODE_ENV=production MODE=standalone-playground bun --bun run vite build --config vite.config.playground.ts && mv dist/apps/playground/playground-assets/index.html dist/apps/playground/index.html"
  },
