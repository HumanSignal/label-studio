# Development-only bearer token. For ChatGPT OAuth, validate the OAuth-issued
# bearer token here or at an upstream HTTPS API proxy.
AGENT_GATEWAY_BEARER_TOKEN=dev-token

# The URL Chromium opens when createSession does not receive app_url.
AGENT_DEFAULT_APP_URL=http://host.docker.internal:8082

# Strongly recommended. Include only local/staging app hosts the agent may open.
AGENT_ALLOWED_HOSTS=host.docker.internal,localhost,127.0.0.1,label-studio-nginx-dev

# Browser mode inside Docker. Headless still records Playwright video.
AGENT_HEADLESS=true

AGENT_RECORDING_DIR=/recordings
